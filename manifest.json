{
  "manifest_version": 3,
  "name": "Disney+ Watched Marker",
  "version": "1.0.0",
  "description": "Marque automatiquement les films et épisodes déjà regardés sur Disney+. Import JSON des contenus déjà vus.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "*://*.disneyplus.com/*",
    "*://disneyplus.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.disneyplus.com/*",
        "*://disneyplus.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Disney+ Watched Marker",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "disneyplus-watched-marker@jeremy.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
